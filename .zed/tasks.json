[
  {
    "label": "backend: vet",
    "command": "make vet 2>&1 | Select-Object -Last 20",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "backend: test (hanya gagal)",
    "command": "go test ./... 2>&1 | Where-Object { $_ -notmatch '^(ok|\\?)\\s' } | Select-Object -Last 30",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "reveal": "always"
  },
  {
    "label": "backend: lint (golangci-lint)",
    "command": "golangci-lint run ./... 2>&1 | Select-Object -Last 25",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "reveal": "always"
  },
  {
    "label": "frontend: dev server",
    "command": "pnpm dev",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "frontend: lint",
    "command": "pnpm lint 2>&1 | Select-Object -Last 25",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "reveal": "always"
  },
  {
    "label": "frontend: typecheck",
    "command": "pnpm exec tsc --noEmit 2>&1 | Select-String 'error TS' | Select-Object -First 20",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "reveal": "always"
  },
  {
    "label": "backend: run API",
    "command": "go run ./cmd/api",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "backend: test package file ini",
    "command": "go test -count=1 . 2>&1 | Select-Object -Last 30",
    "cwd": "$ZED_DIRNAME",
    "reveal": "always"
  },
  {
    "label": "backend: test -race",
    "command": "make test-race 2>&1 | Where-Object { $_ -notmatch '^(ok|\\?)\\s' } | Select-Object -Last 30",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "reveal": "always"
  },
  {
    "label": "backend: fmt",
    "command": "make fmt 2>&1 | Select-Object -Last 10",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "reveal": "always"
  },
  {
    "label": "frontend: build",
    "command": "pnpm build 2>&1 | Select-Object -Last 25",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "reveal": "always"
  },
  {
    "label": "CEK SEMUA (vet+test+lint+tsc)",
    "command": "Push-Location backend; make vet 2>&1 | Select-Object -Last 20; go test ./... 2>&1 | Where-Object { $_ -notmatch '^(ok|\\?)\\s' } | Select-Object -Last 30; Pop-Location; Push-Location frontend; pnpm lint 2>&1 | Select-Object -Last 25; pnpm exec tsc --noEmit 2>&1 | Select-String 'error TS' | Select-Object -First 20; Pop-Location; 'SELESAI'",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "git: status ringkas",
    "command": "git status -sb | Select-Object -First 30",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "backend: test fungsi di kursor",
    "command": "go test -count=1 -v -run \"^$ZED_SYMBOL$\" . 2>&1 | Select-Object -Last 40",
    "cwd": "$ZED_DIRNAME",
    "reveal": "always"
  },
  {
    "label": "backend: test coverage",
    "command": "go test -count=1 \"-coverprofile=cover.out\" ./... 2>&1 | Where-Object { $_ -notmatch '^(ok|\\?)\\s' } | Select-Object -Last 40; go tool cover \"-func=cover.out\" | Select-Object -Last 1; Remove-Item cover.out -ErrorAction SilentlyContinue",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "reveal": "always"
  },
  {
    "label": "backend: test modul order+payment",
    "command": "go test -count=1 ./internal/app/api/order/... ./internal/app/api/payment/... 2>&1 | Select-Object -Last 30",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "reveal": "always"
  },
  {
    "label": "backend: build",
    "command": "go build ./... 2>&1 | Select-Object -Last 20; 'build selesai'",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "reveal": "always"
  },
  {
    "label": "frontend: generate tipe API",
    "command": "pnpm gen:api 2>&1 | Select-Object -Last 15",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "reveal": "always"
  },
  {
    "label": "frontend: test (semua)",
    "command": "pnpm test 2>&1 | Select-Object -Last 40",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "reveal": "always"
  },
  {
    "label": "frontend: test file ini",
    "command": "pnpm exec vitest run (Split-Path \"$ZED_FILE\" -Leaf) 2>&1 | Select-Object -Last 40",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "reveal": "always"
  },
  {
    "label": "backend: test integrasi cart (butuh TEST_DATABASE_URL)",
    "command": "if (-not $env:TEST_DATABASE_URL) { 'Set dulu: $env:TEST_DATABASE_URL (DB uji, bukan produksi)' } else { go test -count=1 -tags integration ./internal/app/api/cart/ 2>&1 | Select-Object -Last 30 }",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "reveal": "always"
  }
]
