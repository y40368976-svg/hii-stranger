[
  {
    "label": "backend: dev (air, hot reload)",
    "command": "air",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "use_new_terminal": true,
    "save": "all",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "backend: build (api.exe)",
    "command": "go build -o api.exe ./cmd/api 2>&1 | Select-Object -Last 20; 'build selesai'",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "save": "all",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "backend: run build (api.exe)",
    "command": ".\\api.exe",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "use_new_terminal": true,
    "save": "none",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "frontend: dev server",
    "command": "pnpm dev",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "use_new_terminal": true,
    "save": "all",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "frontend: run build (pnpm start)",
    "command": "pnpm start",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "use_new_terminal": true,
    "save": "none",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "frontend: build",
    "command": "pnpm build 2>&1 | Select-Object -Last 25",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "save": "all",
    "show_summary": false,
    "show_command": false
  }
]
