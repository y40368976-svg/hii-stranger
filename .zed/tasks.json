    "allow_concurrent_runs": false,
    "label": "START SEMUA build (redis+api.exe+pnpm start)",
    "command": "if (-not (Get-NetTCPConnection -LocalPort 6379 -State Listen -ErrorAction SilentlyContinue)) { Start-Process redis-server -WindowStyle Hidden }; Start-Process pwsh -ArgumentList '-NoExit','-Command','Set-Location backend; .\\api.exe'; Start-Process pwsh -ArgumentList '-NoExit','-Command','Set-Location frontend; pnpm start'; 'redis + api.exe + frontend start dijalankan'",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "none",
    "use_new_terminal": false
  },
  {
    "label": "START SEMUA (redis+backend+frontend)",
    "command": "Start-Process pwsh -ArgumentList '-NoExit','-Command','redis-server --port 6379'; Start-Sleep 1; Start-Process pwsh -WorkingDirectory backend -ArgumentList '-NoExit','-Command','go run ./cmd/api'; Start-Process pwsh -WorkingDirectory frontend -ArgumentList '-NoExit','-Command','pnpm dev'; 'redis, API, dan dev server dibuka di jendela terpisah'",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all",
    "reveal_target": "dock",
    "show_summary": false,
    "show_command": false,
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "STOP SEMUA (frontend+backend+redis)",
    "command": "Get-NetTCPConnection -LocalPort 3000 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }; 'port 3000 bebas'; Get-NetTCPConnection -LocalPort 8080 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }; 'port 8080 bebas'; redis-cli -p 6379 shutdown 2>&1; 'semua mati'",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "none",
